{"chapter": "2", "variables": [{"sym": "x", "color": "x", "meaning": "position, relative to the chosen reference frame", "unit": "m", "section": "2.1"}, {"sym": "x0", "color": "x", "meaning": "initial position", "unit": "m", "section": "2.1"}, {"sym": "xf", "color": "x", "meaning": "final position", "unit": "m", "section": "2.1"}, {"sym": "Δx", "color": "x", "meaning": "displacement, x_f − x_0; the sign gives the direction", "unit": "m", "section": "2.1"}, {"sym": "t", "color": "t", "meaning": "elapsed time, with the initial time taken to be zero (final time on the stopwatch)", "unit": "s", "section": "2.5"}, {"sym": "x0", "color": "x", "meaning": "initial position", "unit": "m", "section": "2.5"}, {"sym": "x", "color": "x", "meaning": "final position", "unit": "m", "section": "2.5"}, {"sym": "Δx", "color": "x", "meaning": "displacement, x − x0", "unit": "m", "section": "2.5"}, {"sym": "v0", "color": "v", "meaning": "initial velocity", "unit": "m/s", "section": "2.5"}, {"sym": "v", "color": "v", "meaning": "final velocity", "unit": "m/s", "section": "2.5"}, {"sym": "v̄", "color": "v", "meaning": "average velocity; equals (v0 + v)/2 when acceleration is constant", "unit": "m/s", "section": "2.5"}, {"sym": "Δv", "color": "v", "meaning": "change in velocity, v − v0", "unit": "m/s", "section": "2.5"}, {"sym": "a", "color": "a", "meaning": "acceleration, assumed constant so that ā = a", "unit": "m/s²", "section": "2.5"}], "equations": [{"id": "eq-dx", "concept": "displacement", "section": "2.1", "latex": "\\Delta x = x_{\\text{f}} - x_0", "ktex": "\\kdx = \\kxf - \\kxo", "anchor": "2.1-displacement", "important": true}, {"id": "eq-notation", "latex": "\\Delta t = t,\\quad \\Delta x = x - x_0,\\quad \\Delta v = v - v_0", "anchor": "2.5-notation", "important": false, "section": "2.5", "ktex": "\\kdt = \\kt,\\quad \\kdx = \\kx - \\kxo,\\quad \\kdv = \\kv - \\kvo"}, {"id": "eq-x-vbar", "concept": "x-from-vbar", "latex": "x = x_0 + \\bar v t", "anchor": "2.5-avg-velocity", "important": true, "constant_a": false, "section": "2.5", "ktex": "\\kx = \\kxo + \\kvb\\kt"}, {"id": "eq-vbar", "concept": "vbar-midpoint", "latex": "\\bar v = \\frac{v_0 + v}{2}", "anchor": "2.5-avg-velocity", "important": true, "constant_a": true, "section": "2.5", "ktex": "\\kvb = \\frac{\\kvo + \\kv}{2}"}, {"id": "eq-v", "concept": "v-from-at", "latex": "v = v_0 + a t", "anchor": "2.5-final-velocity", "important": true, "constant_a": true, "section": "2.5", "ktex": "\\kv = \\kvo + \\ka\\kt"}, {"id": "eq-x", "concept": "x-quadratic", "latex": "x = x_0 + v_0 t + \\tfrac12 a t^2", "anchor": "2.5-position-quadratic", "important": true, "constant_a": true, "section": "2.5", "ktex": "\\kx = \\kxo + \\kvo\\kt + \\tfrac{1}{2}\\ka\\kt^2"}, {"id": "eq-v2", "concept": "v-squared", "latex": "v^2 = v_0^2 + 2a(x - x_0)", "anchor": "2.5-velocity-squared", "important": true, "constant_a": true, "section": "2.5", "ktex": "\\kv^2 = \\kvo^2 + 2\\ka(\\kx - \\kxo)"}], "glossary": [{"section": "2.1", "term": "kinematics", "definition": "the study of motion without considering its causes"}, {"section": "2.1", "term": "position", "definition": "the location of an object at a particular time"}, {"section": "2.1", "term": "displacement", "definition": "the change in position of an object"}, {"section": "2.1", "term": "distance", "definition": "the magnitude of displacement between two positions"}, {"section": "2.1", "term": "distance traveled", "definition": "the total length of the path traveled between two positions"}]}