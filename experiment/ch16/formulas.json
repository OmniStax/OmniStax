   "ktex": "\\kF = -\\kk\\kx",
   "anchor": "16.1-hookes-law",
   "important": true
  },
  {
   "id": "eq-k",
   "section": "16.1",
   "latex": "k = -\\frac{F}{x}",
   "ktex": "\\kk = -\\frac{\\kF}{\\kx}",
   "anchor": "16.1-ex-car",
   "important": false
  },
  {
   "id": "eq-pe-el",
   "concept": "elastic-potential-energy",
   "section": "16.1",
   "latex": "\\text{PE}_{\\text{el}} = \\tfrac{1}{2} k x^2",
   "ktex": "\\kPE = \\tfrac{1}{2}\\kk\\kx^2",
