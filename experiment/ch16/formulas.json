   "important": true
  },
  {
   "id": "eq-shm-frequency",
   "section": "16.3",
   "latex": "f = \\frac{1}{2\\pi}\\sqrt{\\frac{k}{m}}",
   "ktex": "\\kf = \\frac{1}{2\\pi}\\sqrt{\\frac{\\kk}{m}}",
   "anchor": "16.3-shm-period",
   "important": false
  },
  {
   "id": "eq-shm-x",
   "concept": "shm-kinematics",
   "section": "16.3",
   "latex": "x(t) = X\\cos\\frac{2\\pi t}{T}",
   "ktex": "\\kx(\\kt) = \\kX\\cos\\frac{2\\pi\\kt}{\\kT}",
   "anchor": "16.3-shm-waves",
   "important": true
  },
  {
   "id": "eq-shm-v",
