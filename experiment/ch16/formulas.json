{
 "chapter": "16",
 "variables": [
  {
   "sym": "F",
   "color": "F",
   "meaning": "restoring force; the minus sign in Hooke’s law says it points opposite to the displacement",
   "unit": "N",
   "section": "16.1"
  },
  {
   "sym": "F_app",
   "color": "F",
   "meaning": "applied force, equal and opposite to the restoring force while the system is deformed",
   "unit": "N",
   "section": "16.1"
  },
  {
   "sym": "k",
   "color": "F",
   "meaning": "force constant, the stiffness of the system; the slope of the force against displacement graph",
   "unit": "N/m",
   "section": "16.1"
  },
  {
   "sym": "x",
   "color": "x",
   "meaning": "displacement from equilibrium, or deformation",
   "unit": "m",
   "section": "16.1"
  },
  {
   "sym": "PE_el",
   "color": "E",
   "meaning": "elastic potential energy stored in a deformed system that obeys Hooke’s law",
   "unit": "J",
   "section": "16.1"
  },
  {
   "sym": "W",
   "color": "E",
   "meaning": "work done to deform the system; the area under the graph of applied force against deformation",
   "unit": "J",
   "section": "16.1"
  },
  {
   "sym": "m",
   "meaning": "mass",
   "unit": "kg",
   "section": "16.1"
  },
  {
   "sym": "T",
   "color": "t",
   "meaning": "period, the time to complete one oscillation",
   "unit": "s",
   "section": "16.2"
  },
  {
   "sym": "f",
   "color": "t",
   "meaning": "frequency, the number of oscillations per unit time",
   "unit": "Hz",
   "section": "16.2"
  },
  {
   "sym": "Hz",
   "meaning": "hertz, the SI unit of frequency: one cycle per second, or 1/s",
   "unit": "",
   "section": "16.2"
  },
  {
   "sym": "X",
   "color": "x",
   "meaning": "amplitude, the maximum displacement from equilibrium",
   "unit": "m",
   "section": "16.3"
  },
  {
   "sym": "t",
   "color": "t",
   "meaning": "time since the oscillator was released from x = X",
