   "important": false
  },
  {
   "id": "eq-shm-period",
   "concept": "shm-period",
   "section": "16.3",
   "latex": "T = 2\\pi\\sqrt{\\frac{m}{k}}",
   "ktex": "\\kT = 2\\pi\\sqrt{\\frac{m}{\\kk}}",
