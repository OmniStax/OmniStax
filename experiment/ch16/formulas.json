 "equations": [
  {
   "id": "eq-hooke",
   "concept": "hookes-law",
   "section": "16.1",
   "latex": "F = -kx",
   "ktex": "\\kF = -\\kk\\kx",
   "anchor": "16.1-hookes-law",
   "important": true
  },
  {
   "id": "eq-k",
   "section": "16.1",
   "latex": "k = -\\frac{F}{x}",
   "ktex": "\\kk = -\\frac{\\kF}{\\kx}",
   "anchor": "16.1-ex-car",
   "important": false
  },
  {
   "id": "eq-pe-el",
   "concept": "elastic-potential-energy",
   "section": "16.1",
   "latex": "\\text{PE}_{\\text{el}} = \\tfrac{1}{2} k x^2",
   "ktex": "\\kPE = \\tfrac{1}{2}\\kk\\kx^2",
   "anchor": "16.1-elastic-energy",
   "important": true
  },
  {
   "id": "eq-period-frequency",
   "concept": "period-frequency",
   "section": "16.2",
   "latex": "f = \\frac{1}{T}",
   "ktex": "\\kf = \\frac{1}{\\kT}",
   "anchor": "16.2-frequency",
   "important": true
  },
  {
   "id": "eq-frequency-period",
   "section": "16.2",
   "latex": "T = \\frac{1}{f}",
   "ktex": "\\kT = \\frac{1}{\\kf}",
   "anchor": "16.2-ex-ultrasound",
   "important": false
  },
  {
   "id": "eq-shm-period",
   "concept": "shm-period",
   "section": "16.3",
   "latex": "T = 2\\pi\\sqrt{\\frac{m}{k}}",
   "ktex": "\\kT = 2\\pi\\sqrt{\\frac{m}{\\kk}}",
   "anchor": "16.3-shm-period",
   "important": true
  },
  {
   "id": "eq-shm-frequency",
   "section": "16.3",
   "latex": "f = \\frac{1}{2\\pi}\\sqrt{\\frac{k}{m}}",
   "ktex": "\\kf = \\frac{1}{2\\pi}\\sqrt{\\frac{\\kk}{m}}",
   "anchor": "16.3-shm-period",
   "important": false
  },
  {
   "id": "eq-shm-x",
   "concept": "shm-kinematics",
   "section": "16.3",
   "latex": "x(t) = X\\cos\\frac{2\\pi t}{T}",
   "ktex": "\\kx(\\kt) = \\kX\\cos\\frac{2\\pi\\kt}{\\kT}",
   "anchor": "16.3-shm-waves",
   "important": true
  },
  {
   "id": "eq-shm-v",
   "section": "16.3",
   "latex": "v(t) = -v_{\\text{max}}\\sin\\frac{2\\pi t}{T}",
   "ktex": "\\kv(\\kt) = -\\kvmax\\sin\\frac{2\\pi\\kt}{\\kT}",
   "anchor": "16.3-shm-waves",
   "important": false
  },
  {
   "id": "eq-vmax",
   "section": "16.3",
   "latex": "v_{\\text{max}} = \\frac{2\\pi X}{T} = X\\sqrt{\\frac{k}{m}}",
   "ktex": "\\kvmax = \\frac{2\\pi\\kX}{\\kT} = \\kX\\sqrt{\\frac{\\kk}{m}}",
   "anchor": "16.3-shm-waves",
   "important": false
  },
  {
   "id": "eq-shm-a",
   "section": "16.3",
   "latex": "a(t) = -\\frac{kX}{m}\\cos\\frac{2\\pi t}{T}",
   "ktex": "\\ka(\\kt) = -\\frac{\\kk\\kX}{m}\\cos\\frac{2\\pi\\kt}{\\kT}",
   "anchor": "16.3-shm-waves",
   "important": false
  }
 ],
 "glossary": [
  {
   "section": "16.1",
   "term": "deformation",
   "definition": "displacement from equilibrium"
  },
  {
   "section": "16.1",
   "term": "elastic potential energy",
   "definition": "potential energy stored as a result of deformation of an elastic object, such as the stretching of a spring"
  },
  {
   "section": "16.1",
   "term": "force constant",
   "definition": "a constant related to the rigidity of a system: the larger the force constant, the more rigid the system; the force constant is represented by k"
  },
  {
   "section": "16.1",
   "term": "restoring force",
   "definition": "force acting in opposition to the force caused by a deformation"
  },
  {
   "section": "16.2",
   "term": "period",
   "definition": "time it takes to complete one oscillation"
  },
  {
   "section": "16.2",
   "term": "periodic motion",
   "definition": "motion that repeats itself at regular time intervals"
  },
  {
   "section": "16.2",
   "term": "frequency",
   "definition": "number of events per unit of time"
  },
  {
   "section": "16.3",
   "term": "amplitude",
   "definition": "the maximum displacement from the equilibrium position of an object oscillating around the equilibrium position"
  },
  {
   "section": "16.3",
   "term": "simple harmonic motion",
   "definition": "the oscillatory motion in a system where the net force can be described by Hooke’s law"
  },
  {
   "section": "16.3",
   "term": "simple harmonic oscillator",
   "definition": "a device that implements Hooke’s law, such as a mass that is attached to a spring, with the other end of the spring being connected to a rigid support such as a wall"
  }
 ]
}