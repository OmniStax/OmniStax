 "glossary": [
  {
   "section": "16.1",
   "term": "deformation",
   "definition": "displacement from equilibrium"
  },
  {
   "section": "16.1",
   "term": "elastic potential energy",
   "definition": "potential energy stored as a result of deformation of an elastic object, such as the stretching of a spring"
  },
  {
   "section": "16.1",
   "term": "force constant",
   "definition": "a constant related to the rigidity of a system: the larger the force constant, the more rigid the system; the force constant is represented by k"
  },
  {
   "section": "16.1",
   "term": "restoring force",
   "definition": "force acting in opposition to the force caused by a deformation"
  },
  {
   "section": "16.2",
   "term": "period",
   "definition": "time it takes to complete one oscillation"
  },
  {
   "section": "16.2",
   "term": "periodic motion",
   "definition": "motion that repeats itself at regular time intervals"
  },
  {
   "section": "16.2",
   "term": "frequency",
   "definition": "number of events per unit of time"
  }
 ]
