   "unit": "N",
   "section": "16.1"
  },
  {
   "sym": "F_app",
   "color": "force",
   "meaning": "applied force, equal and opposite to the restoring force while the system is deformed",
   "unit": "N",
   "section": "16.1"
  },
  {
   "sym": "k",
   "color": "stiffness",
   "meaning": "force constant, the stiffness of the system; the slope of the force against displacement graph",
   "unit": "N/m",
   "section": "16.1"
  },
  {
   "sym": "x",
   "color": "position",
   "meaning": "displacement from equilibrium, or deformation",
   "unit": "m",
   "section": "16.1"
  },
  {
   "sym": "PE_el",
   "color": "energy",
   "meaning": "elastic potential energy stored in a deformed system that obeys Hooke’s law",
   "unit": "J",
   "section": "16.1"
  },
  {
   "sym": "W",
   "color": "energy",
   "meaning": "work done to deform the system; the area under the graph of applied force against deformation",
   "unit": "J",
   "section": "16.1"
  },
  {
   "sym": "m",
   "meaning": "mass",
   "unit": "kg",
   "section": "16.1"
  },
  {
