  },
  {
   "sym": "f",
   "color": "frequency",
   "meaning": "frequency, the number of oscillations per unit time",
   "unit": "Hz",
   "section": "16.2"
  },
  {
   "sym": "Hz",
   "meaning": "hertz, the SI unit of frequency: one cycle per second, or 1/s",
   "unit": "",
   "section": "16.2"
  },
  {
   "sym": "X",
   "color": "position",
   "meaning": "amplitude, the maximum displacement from equilibrium",
   "unit": "m",
   "section": "16.3"
  },
  {
   "sym": "t",
   "color": "time",
