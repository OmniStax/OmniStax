---
/* What every page's head shares: metadata, fonts and the theme attribute
   restored before first paint, so a plain page and a section page match. */
type Props = { title: string; description: string; canonical: string };
const { title, description, canonical } = Astro.props;
---
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Source+Sans+3:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<script is:inline>document.documentElement.classList.add('js');try{var t=localStorage.getItem('omnia-theme');if(t==="dark"||t==="light")document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
<slot />
