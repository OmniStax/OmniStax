---
/* The long form of the credit every section footer carries: the source, what
   Omnia changes, the licence the adapted pages are shared under, and each
   built section beside its original. A plain page, no shell. */
import '../../styles/global.css';
import Head from '../../layouts/Head.astro';
import { config } from '../../../omnia.config';
import { tree } from '../../lib/content/paths';
import { attributionUrl, attributionOf, citation, nameList } from '../../lib/content/attribution';

export const getStaticPaths = async () => [{ params: { book: (await tree()).dto.id } }];
const t = await tree();
const book = t.dto;
const url = attributionUrl(book.id);
const canonical = new URL(url, config.site.baseUrl).href;
const title = `Attribution · ${book.title}`;
const description = `Where the text of ${book.title} on Omnia comes from, what was changed, and the licence it is shared under.`;
const authors = nameList(book.authors);
const built = t.chapters.flatMap((ch) => ch.sections.map((s) => ({
  meta: s.meta,
  entry: t.manifest.chapters.find((c) => c.dir === ch.dto.dir)?.sections.find((e) => e.id === s.meta.id),
  credit: attributionOf(book, ch.dto, s.meta),
})));
const first = built[0];
const bookCredit = attributionOf(book, { id: '', dir: '', title: '', sections: [] }, { id: '', notes: '' });
---
<!doctype html>
<html lang="en" data-book={book.id}>
<head>
<Head {title} {description} {canonical} />
{book.licenseUrl && <link rel="license" href={book.licenseUrl} />}
</head>
<body>
<article>
<div class="eyebrow">Omnia · {book.title}</div>
<h1>Attribution</h1>
<p class="lead">Every section on this site is an adaptation of an open textbook. This page says which one, what was changed, and on what terms the result may be reused.</p>

<section id="source">
<h2>Source</h2>
<p>The text is from <cite>{book.title}</cite>{authors && <> by {authors}</>}, published by {book.sourceUrl ? <a href={book.sourceUrl}>{book.publisher}</a> : book.publisher}{book.copyright && <>, © {book.copyright},</>} and licensed under {book.licenseUrl ? <a rel="license" href={book.licenseUrl}>{book.license}</a> : book.license}. {book.publisher} asks that any reuse carry the line “Access for free at” followed by the address of the original page. Each section's footer does, and the list below repeats it.</p>
<p>{book.publisher} did not produce and does not endorse this adaptation. The {book.publisher} name and logo are trademarks of their owner and are used here only to say where the text comes from.</p>
</section>

<section id="changes">
<h2>What Omnia changes</h2>
<p>The book's prose is quoted as written and regrouped under headers of Omnia's own. Everything else on a section page is Omnia's work, made from the book's material:</p>
<ul>
<li>The book's sketch figures are redrawn as live demos that cover the same quantities. Photographs are left out.</li>
<li>Exercises are re-set with answer checking against the book's answer key. Exercises with no answer in the key are left out and named in the section's footer.</li>
<li>The concept map, formula sheet and definitions are drawn out of the section's own text.</li>
<li>Suggested approaches marked AI are written by Omnia, not the book.</li>
</ul>
<p>Anything a particular section leaves out is stated in one sentence in that section's footer.</p>
</section>

<section id="licence">
<h2>Licence of these pages</h2>
<p>The source licence requires adaptations to be shared under the same terms, so every adapted page on this site, its text, redrawn figures and re-set exercises, is licensed under {book.licenseUrl ? <a rel="license" href={book.licenseUrl}>{book.license}</a> : book.license}. You may copy and adapt them for non-commercial use under that licence. Credit both the original and Omnia. A line like the following will do, with the address of the page you used:</p>
<blockquote><p>{citation(bookCredit)} Adapted version from Omnia at {config.site.baseUrl}.</p></blockquote>
<p>The Omnia software that builds and displays these pages is a separate work and is not covered by the content licence.</p>
</section>

<section id="sections">
<h2>Sections adapted so far</h2>
<p>Each section beside the original it was adapted from.</p>
<table>
<thead><tr><th>Section</th><th>Original</th><th>Left out</th></tr></thead>
<tbody>
{built.map(({ meta, entry, credit }) => (
  <tr>
    <td><a href={entry?.url}>{meta.id} {meta.title}</a></td>
    <td>{credit.sourceUrl ? <a href={credit.sourceUrl}>{credit.sourceUrl.replace(/^https?:\/\//, '')}</a> : '—'}</td>
    <td>{meta.notes || '—'}</td>
  </tr>
))}
</tbody>
</table>
</section>

<footer class="footer"><p>{first && <a href={first.entry?.url}>Back to the book</a>}</p></footer>
</article>
</body>
</html>
