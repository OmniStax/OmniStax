{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "$lib/*": ["src/lib/*"], "$components/*": ["src/components/*"] },
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["src/**/*", "omnistax.config.ts", "scripts/**/*", "tests/**/*", ".astro/types.d.ts"]
}
