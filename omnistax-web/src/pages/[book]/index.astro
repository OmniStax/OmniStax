---
/* The front of one book, which is the shell with the book page open in it: its
   title and every chapter and section, each a link into the text. */
import ShellPage from '../../layouts/ShellPage.astro';
import { tree } from '../../lib/content/paths';
import { bookHtml } from '../../lib/content/pages';
import { pageItem } from '../../lib/types/ids';
import type { BookTree } from '../../lib/content/load';
export const getStaticPaths = async () => { const t = await tree(); return [{ params: { book: t.dto.id }, props: { tree: t } }]; };
const { tree: t } = Astro.props as { tree: BookTree };
const m = t.manifest;
---
<ShellPage
  tree={t}
  own={pageItem('book')}
  pool={bookHtml(m)}
  title={m.title}
  description={`Contents of ${m.title}, an interactive edition of the ${m.publisher} text.`}
  book={m.id}
>
  <Fragment slot="head">
    {m.licenseUrl && <link rel="license" href={m.licenseUrl} />}
  </Fragment>
</ShellPage>
