---
/* The book's own introduction or preface, where it prints one: a page of its own,
   listed before the first chapter (rule 21) and rendered by the same page a
   section is. A literal route wins over [chapter], so /<book>/intro/ is this
   page and never a chapter called intro. */
import Page from '../../../layouts/Page.astro';
import { shellRoutes } from '../../../lib/content/paths';
import type { ShellProps } from '../../../lib/content/paths';
import type { PageShell } from '../../../lib/content/shells';
export const getStaticPaths = shellRoutes('intro');
const { manifest, shell, pool, editions } = Astro.props as ShellProps;
---
<Page manifest={manifest} shell={shell as PageShell} pool={pool} editions={editions} />
