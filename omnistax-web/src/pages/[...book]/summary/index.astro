---
/* The book's own closing summary, where it prints one: a page of its own,
   listed after the last chapter (rule 21) and rendered by the same page a
   section is. A literal route wins over [chapter], so /<book>/summary/ is this
   page and never a chapter called summary. */
import Page from '../../../layouts/Page.astro';
import { shellRoutes } from '../../../lib/content/paths';
import type { ShellProps } from '../../../lib/content/paths';
import type { PageShell } from '../../../lib/content/shells';
export const getStaticPaths = shellRoutes('summary');
const { manifest, shell, pool, editions } = Astro.props as ShellProps;
---
<Page manifest={manifest} shell={shell as PageShell} pool={pool} editions={editions} />
