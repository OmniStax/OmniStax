---
/* One reference sheet of a book, which is the shell with that sheet open in it.
   The sheet is data rather than prose, so the page carries no static article:
   the component fetches the sheet beside it and draws it, and the pool is empty
   but for the heading a reader without JavaScript is owed. */
import ShellPage from '../../../../layouts/ShellPage.astro';
import { shellRoutes } from '../../../../lib/content/paths';
import type { ShellProps } from '../../../../lib/content/paths';
export const getStaticPaths = shellRoutes('sheet');
const { manifest, shell, pool } = Astro.props as ShellProps;
---
<ShellPage
  manifest={manifest}
  own={shell.own}
  lang={shell.lang}
  pool={pool}
  title={shell.title}
  description={shell.description}
>
  <Fragment slot="head">
    {shell.license && <link rel="license" href={shell.license} />}
  </Fragment>
</ShellPage>
