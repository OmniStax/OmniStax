---
/* The desktop installers, the visitor's own system first. The files are the
   newest GitHub release that has installers (docs/release-plan.md, decision 9),
   at names that never change, so the page never does either. */
import { tIn } from '../lib/i18n/index';
const locale = 'en';
const t = (key: Parameters<typeof tIn>[1], params?: Parameters<typeof tIn>[2]): string => tIn(locale, key, params);
const RELEASES = 'https://github.com/BlastWind/OmniStax/releases';
const systems = [
  { id: 'windows', name: 'Windows', file: 'OmniStax-Setup.exe' },
  { id: 'mac', name: 'macOS', file: 'OmniStax.dmg' },
  { id: 'linux', name: 'Linux', file: 'OmniStax.AppImage' },
];
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{t('about.download.title')}</title>
  <meta name="description" content={t('about.download.description')}>
  <link rel="icon" href="/icons/icon-192.png">
  <style>
    :root{--ink:#1c1b19;--muted:#6b6862;--rule:#e2dfd8;--panel:#fbfaf7;--bg:#f4f2ed;--accent:#1d4ed8;--on-accent:#fff}
    @media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--ink:#ecebe7;--muted:#a19e97;--rule:#3a3935;--panel:#24231f;--bg:#1a1916;--accent:#7aa2ff;--on-accent:#0d1530}}
    :root[data-theme="dark"]{--ink:#ecebe7;--muted:#a19e97;--rule:#3a3935;--panel:#24231f;--bg:#1a1916;--accent:#7aa2ff;--on-accent:#0d1530}
    body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,sans-serif}
    main{max-width:34rem;margin:14vh auto;padding:0 16px}
    h1{font-size:1.75rem;margin:0 0 24px}
    ul{list-style:none;margin:0 0 24px;padding:0;display:flex;flex-direction:column;gap:8px}
    a.get{display:block;padding:12px 16px;border:1px solid var(--rule);border-radius:8px;background:var(--panel);color:var(--ink);text-decoration:none}
    a.get:hover{border-color:var(--accent)}
    li:first-child a.get{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
    .more{display:flex;gap:16px;flex-wrap:wrap;font-size:.9rem}
    .more a{color:var(--muted)}
  </style>
</head>
<body>
  <main>
    <h1>{t('about.download.title')}</h1>
    <ul id="systems">
      {systems.map((s) => <li data-os={s.id}><a class="get" href={`${RELEASES}/latest/download/${s.file}`}>{t('about.download.for', { os: s.name })}</a></li>)}
    </ul>
    <p class="more"><a href={RELEASES}>{t('about.download.older')}</a><a href="/">{t('about.download.browser')}</a></p>
  </main>
  <script is:inline>
    (function () {
      var ua = navigator.userAgent, os = /Windows/.test(ua) ? 'windows' : /Mac/.test(ua) ? 'mac' : /Linux|X11/.test(ua) && !/Android/.test(ua) ? 'linux' : null;
      var li = os && document.querySelector('[data-os="' + os + '"]');
      if (li) li.parentNode.prepend(li);
    })();
  </script>
</body>
</html>
