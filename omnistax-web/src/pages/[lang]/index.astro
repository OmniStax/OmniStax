---
/* The same page in every other language the app speaks: /zh-CN/… */
import FrontPage from '../../layouts/FrontPage.astro';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../../lib/i18n/index';
export const getStaticPaths = () => LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
const { lang } = Astro.params as { lang: Locale };
---
<FrontPage locale={lang} />
