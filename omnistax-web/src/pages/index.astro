---
/* The front of OmniStax, which is the shell with the about page open in it: the
   same rail, explorer and groups as anywhere else, and the introduction as the
   one tab the page carries. */
import ShellPage from '../layouts/ShellPage.astro';
import { trees } from '../lib/content/paths';
import { aboutHtml } from '../lib/content/pages';
import { aboutItem } from '../lib/types/ids';
const books = await trees();
if (books.length === 0) throw new Error('this build carries no books: check OMNISTAX_CONTENT_DIR and OMNISTAX_BOOKS');
/* The about page belongs to no book; it takes the first book's colour tokens, which is all the shell asks a tree for here. */
const t = books[0];
const description = 'OmniStax/万象 is a next-gen, self-hostable STEM learning platform built from open source textbooks.';
---
<ShellPage
  tree={t}
  own={aboutItem()}
  pool={aboutHtml()}
  title="OmniStax"
  description={description}
/>
