---
/* One page of the book as a static page: metadata for crawlers, the article in
   the document, and the shell mounted on top with that page's text as the item
   the page is. The page is a section, or the introduction or summary a chapter
   or the book opens or closes on, which share a section's machinery (rule 21).
   It is rendered from the page's record (shells.ts) and its doc.html, so a book
   taken from the store needs no reading of its folder. Everything the pages of
   the site share — fonts, colour tokens, the pool, the island — is in ShellPage
   beneath this. */
import ShellPage from './ShellPage.astro';
import type { BookManifest } from '../lib/content/schema';
import type { Edition, PageShell } from '../lib/content/shells';

type Props = { manifest: BookManifest; shell: PageShell; pool: string; editions: readonly Edition[] };
const { manifest, shell, pool, editions } = Astro.props as Props;
---
<ShellPage
  manifest={manifest}
  own={shell.own}
  pool={pool}
  title={shell.title}
  description={shell.description}
  chapterDir={shell.chapterDir}
  lang={shell.lang}
>
  <Fragment slot="head">
    <link rel="canonical" href={shell.canonical}>
    {editions.length > 1 && editions.map((e) => <link rel="alternate" hreflang={e.lang} href={e.href} />)}
    {shell.prev && <link rel="prev" href={shell.prev} />}
    {shell.next && <link rel="next" href={shell.next} />}
    {shell.license && <link rel="license" href={shell.license} />}
    <script type="application/ld+json" set:html={JSON.stringify(shell.ld)}></script>
  </Fragment>
  <Fragment slot="scripts">
    <script is:inline src={`${shell.url}figures.js`}></script>
  </Fragment>
</ShellPage>
