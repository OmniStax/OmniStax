---
/* Every page of the site is the same shell over a different item: the front of
   OmniStax, the front of the book, or one section. What they share is here —
   the fonts, the book's colour tokens, the theme script, the static pool the
   registry adopts from, and the island itself — and what only one of them needs
   goes into the `head` slot beside it. */
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Shell from '../components/Shell.svelte';
import { config } from '../../omnistax.config';
import type { BookTree } from '../lib/content/load';
import type { ItemId } from '../lib/types/ids';
import type { SectionMetaDTO, ExerciseDTO, ConceptsDTO, FormulasDTO } from '../lib/content/schema';
import { NO_CHOICES, cssFor } from '../lib/colours/model';

export type Props = {
  tree: BookTree;
  own: ItemId;                  /* what this page is: the item the shell opens and keeps open */
  pool: string;                 /* the static HTML the registry adopts on mount */
  title: string;
  description: string;
  book?: string; chapter?: string; section?: string;    /* what the html element says this page is */
  chapterDir?: string;
  chapterData?: { concepts: ConceptsDTO; formulas: FormulasDTO };
  meta?: SectionMetaDTO;
  exercises?: readonly ExerciseDTO[];
};
const { tree, own, pool, title, description, book, chapter, section, chapterDir, chapterData, meta, exercises } = Astro.props as Props;
/* Colour is a function of type. The book declares its quantities and the app
   dresses them from its scheme, which is what these tokens carry; the shell's
   own style element comes after this one in the head, so the colours the reader
   has chosen win over it. Dark comes in three states: system, forced, or light. */
const colourCss = cssFor(tree.manifest, NO_CHOICES);
const kvRules = Object.keys(tree.manifest.types).map((k) => `.kv-${k}{color:var(--c-${k})} html:not(.cc) .kv-${k}{color:inherit} html.cc .s-${k}::-webkit-slider-thumb{background:var(--c-${k})} html.cc .s-${k}::-moz-range-thumb{background:var(--c-${k})}`).join('\n');
const unbound = tree.chapters.flatMap((ch) => ch.sections.filter((s) => s.meta.binds.length).map((s) => {
  const off = Object.keys(tree.manifest.types).filter((k) => !s.meta.binds.includes(k));
  return off.length ? `article[data-sec="${s.meta.id}"] :is(${off.map((k) => `.kv-${k}`).join(',')}){color:inherit}` : '';
})).join('\n');
const shellProps = { manifest: tree.manifest, own, chapterDir, chapterData, section: meta, exercises, threeUrl: config.build.threeUrl };
---
<!doctype html>
<html lang="en" data-book={book} data-chapter={chapter} data-section={section}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<!-- Installed as an app, the shell keeps Ctrl+W for its own groups: a browser tab never hands that chord to a page. -->
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#1D4ED8">
<link rel="icon" href="/icons/icon-192.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=Source+Sans+3:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<style is:inline set:html={`${colourCss}\n${kvRules}\n${unbound}`}></style>
<script is:inline>document.documentElement.classList.add('js');try{var t=localStorage.getItem('omnistax-theme');if(t==="dark"||t==="light")document.documentElement.setAttribute('data-theme',t);if(localStorage.getItem('omnistax-underlines')==="0")document.documentElement.classList.add('no-underlines')}catch(e){}</script>
<slot name="head" />
</head>
<body>
<div id="pool" set:html={pool}></div>
<!-- Three comes before anything that draws: a section reached from the front of
     the book opens its figures in this document, so every page carries it. -->
<script is:inline src={config.build.threeUrl}></script>
<slot name="scripts" />
<Shell client:only="svelte" {...shellProps} />
</body>
</html>
