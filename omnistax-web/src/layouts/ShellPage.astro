---
/* Every page of the site is the same shell over a different item: the front of
   OmniStax, the front of the book, or one section. What they share is here —
   the fonts, the book's colour tokens, the theme script, the static pool the
   registry adopts from, and the island itself — and what only one of them needs
   goes into the `head` slot beside it. */
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import ShellLoader from '../components/ShellLoader.svelte';
import { config } from '../../omnistax.config';
import type { BookTree } from '../lib/content/load';
import type { ItemId } from '../lib/types/ids';
import type { BootUrls } from '../lib/sections/boot';
import { BOOK_RULES_ID, bookColoursHref } from '../lib/colours/rules';

export type Props = {
  tree: BookTree;
  own: ItemId;                  /* what this page is: the item the shell opens and keeps open */
  pool: string;                 /* the static HTML the registry adopts on mount */
  title: string;
  description: string;
  book?: string; chapter?: string; section?: string;    /* what the html element says this page is */
  chapterDir?: string;
};
const { tree, own, pool, title, description, book, chapter, section, chapterDir } = Astro.props as Props;
/* Colour is a function of type. The book declares its quantities and the app
   dresses them from its scheme: the book's colours.css carries the scheme's
   tokens and which classes wear them, one file for every page of the book, and
   the shell points it at another book if the reader walks into one without
   leaving the app. The shell's own style element comes after it in the head,
   so the colours the reader has chosen win over it. */
const colourHref = bookColoursHref(tree.manifest.id);
/* The island gets only what is small: where the manifest and the chapter's
   concepts and formulas live, which the loader fetches (src/lib/sections/boot.ts).
   Every page of a book names the same files, so a reader, and an offline copy,
   holds one of each rather than one inside every page. */
const ch = chapterDir ? tree.manifest.chapters.find((c) => c.dir === chapterDir) : undefined;
const boot: BootUrls = { manifest: `/${tree.manifest.id}/book.json`, ...(ch ? { chapter: { dir: ch.dir, concepts: ch.concepts, formulas: ch.formulas } } : {}) };
const shellProps = { own, threeUrl: config.build.threeUrl, boot };
---
<!doctype html>
<html lang="en" data-book={book} data-chapter={chapter} data-section={section}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<!-- Installed as an app, the shell keeps Ctrl+W for its own groups: a browser tab never hands that chord to a page. -->
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#1D4ED8">
<link rel="icon" href="/icons/icon-192.png" type="image/png">
<!-- Offline releases have no cross-origin runtime dependency. The font stacks
     use locally installed faces and their system fallbacks. -->
<link id={BOOK_RULES_ID} rel="stylesheet" href={colourHref}>
<link rel="preload" href={boot.manifest} as="fetch" crossorigin="anonymous">
{boot.chapter && <link rel="preload" href={boot.chapter.concepts} as="fetch" crossorigin="anonymous">}
{boot.chapter && <link rel="preload" href={boot.chapter.formulas} as="fetch" crossorigin="anonymous">}
<script is:inline>document.documentElement.classList.add('js');try{var t=localStorage.getItem('omnistax-theme');if(t==="dark"||t==="light")document.documentElement.setAttribute('data-theme',t);if(localStorage.getItem('omnistax-underlines')==="0")document.documentElement.classList.add('no-underlines')}catch(e){}</script>
<slot name="head" />
</head>
<body>
<div id="pool" set:html={pool}></div>
<slot name="scripts" />
<ShellLoader client:only="svelte" {...shellProps} />
</body>
</html>
