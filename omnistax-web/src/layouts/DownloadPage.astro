---
/* The desktop installers in one language, as the shell with the Download page
   open in it, so /download is a tab of the app like any other page and the
   reader can go back to what they were reading. */
import ShellPage from './ShellPage.astro';
import Alternates from './Alternates.astro';
import { downloadHtml } from '../lib/content/pages';
import { downloadItem } from '../lib/types/ids';
import { tIn, type Locale } from '../lib/i18n/index';
type Props = { locale: Locale };
const { locale } = Astro.props as Props;
---
<ShellPage own={downloadItem()} pool={downloadHtml(locale)} title={tIn(locale, 'about.download.title')} description={tIn(locale, 'about.download.description')} lang={locale}>
  <Alternates slot="head" path="/download/" locale={locale} />
</ShellPage>
