---
/* The desktop installers, the visitor's own system first. The files are the
   newest GitHub release that has installers (docs/release-plan.md, decision 9),
   at names that never change, so the page never does either. It is built once
   per language (/download, /zh-CN/download) and carries its words in every
   language; the script below puts them in the reader's, chosen as the app
   chooses (readerLocale), so a reader's own choice wins over the address. */
import Alternates from './Alternates.astro';
import { LOCALES, localePath, tIn, type Locale } from '../lib/i18n/index';
type Props = { locale: Locale };
const { locale } = Astro.props as Props;
const t = (key: Parameters<typeof tIn>[1], params?: Parameters<typeof tIn>[2]): string => tIn(locale, key, params);
const RELEASES = 'https://github.com/OmniStax/OmniStax/releases';
const systems = [
  { id: 'windows', name: 'Windows', file: 'OmniStax-Setup.exe' },
  { id: 'mac', name: 'macOS', file: 'OmniStax.dmg' },
  { id: 'linux', name: 'Linux', file: 'OmniStax.AppImage' },
];
const words = Object.fromEntries(LOCALES.map((l) => [l, {
  title: tIn(l, 'about.download.title'), older: tIn(l, 'about.download.older'), browser: tIn(l, 'about.download.browser'),
  ...Object.fromEntries(systems.map((s) => [s.id, tIn(l, 'about.download.for', { os: s.name })])),
}]));
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{t('about.download.title')}</title>
  <meta name="description" content={t('about.download.description')}>
  <link rel="icon" href="/logos/wanxiang-icon-small.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <Alternates path="/download/" locale={locale} />
  <style>
    :root{--ink:#1c1b19;--muted:#6b6862;--rule:#e2dfd8;--panel:#fbfaf7;--bg:#f4f2ed;--accent:#1d4ed8;--on-accent:#fff}
    @media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--ink:#ecebe7;--muted:#a19e97;--rule:#3a3935;--panel:#24231f;--bg:#1a1916;--accent:#7aa2ff;--on-accent:#0d1530}}
    :root[data-theme="dark"]{--ink:#ecebe7;--muted:#a19e97;--rule:#3a3935;--panel:#24231f;--bg:#1a1916;--accent:#7aa2ff;--on-accent:#0d1530}
    body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,sans-serif}
    main{max-width:34rem;margin:14vh auto;padding:0 16px}
    h1{font-size:1.75rem;margin:0 0 24px}
    ul{list-style:none;margin:0 0 24px;padding:0;display:flex;flex-direction:column;gap:8px}
    a.get{display:block;padding:12px 16px;border:1px solid var(--rule);border-radius:8px;background:var(--panel);color:var(--ink);text-decoration:none}
    a.get:hover{border-color:var(--accent)}
    li:first-child a.get{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
    .more{display:flex;gap:16px;flex-wrap:wrap;font-size:.9rem}
    .more a{color:var(--muted)}
  </style>
</head>
<body>
  <main>
    <h1 data-word="title">{t('about.download.title')}</h1>
    <ul id="systems">
      {systems.map((s) => <li data-os={s.id}><a class="get" data-word={s.id} href={`${RELEASES}/latest/download/${s.file}`}>{t('about.download.for', { os: s.name })}</a></li>)}
    </ul>
    <p class="more"><a data-word="older" href={RELEASES}>{t('about.download.older')}</a><a data-word="browser" href={localePath('/', locale)}>{t('about.download.browser')}</a></p>
  </main>
  <script type="application/json" id="words" set:html={JSON.stringify(words)}></script>
  <script>
    import { localePath, readerLocale, type Locale } from '../lib/i18n/locale';
    const stored = (() => { try { return localStorage.getItem('omnistax-lang'); } catch { return null; } })();
    const locale: Locale = readerLocale(location.pathname, stored, navigator.languages ?? [navigator.language]);
    const words = JSON.parse(document.getElementById('words')?.textContent ?? '{}') as Record<string, Record<string, string>>;
    document.documentElement.lang = locale;
    document.querySelectorAll<HTMLElement>('[data-word]').forEach((el) => { el.textContent = words[locale]?.[el.dataset.word ?? ''] ?? el.textContent; });
    if (words[locale]?.title) document.title = words[locale].title;
    document.querySelector('[data-word="browser"]')?.setAttribute('href', localePath('/', locale));
    const ua = navigator.userAgent;
    const os = /Windows/.test(ua) ? 'windows' : /Mac/.test(ua) ? 'mac' : /Linux|X11/.test(ua) && !/Android/.test(ua) ? 'linux' : null;
    const li = os ? document.querySelector(`[data-os="${os}"]`) : null;
    if (li) li.parentElement?.prepend(li);
  </script>
</body>
</html>
