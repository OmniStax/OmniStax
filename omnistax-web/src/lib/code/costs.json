      "bisect.bisect_left": "log n", "bisect.bisect_right": "log n", "bisect.bisect": "log n",
      "bisect.insort_left": "n", "bisect.insort_right": "n", "bisect.insort": "n",
      "heapq.heappush": "log n", "heapq.heappop": "log n", "heapq.heappushpop": "log n", "heapq.heapreplace": "log n",
      "heapq.heapify": "n", "heapq.nlargest": "n", "heapq.nsmallest": "n"
    }
  },
