<row><entry align="left"><m:math><m:msub><m:mi>m</m:mi><m:mtext>e</m:mtext></m:msub></m:math></entry><entry align="left">9.1093897</entry></row>
<row><entry align="left"><m:math><m:msubsup><m:mrow/><m:mrow><m:mn>6</m:mn></m:mrow><m:mn>14</m:mn></m:msubsup><m:mtext>C</m:mtext></m:math></entry><entry align="left">—</entry></row>
