<thead>
<row valign="middle">
<entry namest="c1" nameend="c2">Fundamental Physical Constants</entry>
</row>
<row valign="middle">
<entry align="left">Name and Symbol</entry>
<entry align="left">Value<footnote>Every value is the one the book prints.</footnote></entry>
</row>
</thead>
<tbody>
<row valign="middle">
<entry align="left">atomic mass unit (amu)</entry>
<entry align="left">1.6605402 <m:math><m:mo>×</m:mo></m:math>  10<sup>−27</sup> kg</entry>
</row>
<row valign="middle">
<entry align="left">Boltzmann’s constant (<emphasis effect="italics">k</emphasis>)</entry>
<entry align="left">1.380649 <m:math><m:mo>×</m:mo></m:math> 10<sup>−23</sup> J K<sup>−1</sup></entry>
</row>
</tbody>
</tgroup>
</table>

