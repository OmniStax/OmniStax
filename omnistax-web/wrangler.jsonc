/* Cloudflare Workers: serve the built site as static assets. No script; the
   platform handles routing, with /x resolving to /x/index.html, and any
   address with no page gets 404.html, the shell that reads the address. */
{
  "name": "omnistax",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
